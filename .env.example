# App
APP_NAME=AnythingLLM Mini
APP_ENV=dev
DEBUG=true

# LLM
LLM_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Database
DATABASE_URL=sqlite:///./anythingllm_mini.db

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/anythingllm_mini

# Vector store
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=anythingllm-mini-documents

# File storage
UPLOAD_DIR=./storage/uploads
PARSED_DIR=./storage/parsed

# RAG
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
SIMILARITY_THRESHOLD=0.75

# Agent
AGENT_MAX_STEPS=5
