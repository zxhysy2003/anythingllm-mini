# App
APP_NAME=AnythingLLM Mini
APP_ENV=dev
DEBUG=true

# LLM
LLM_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Database
DATABASE_URL=sqlite:///./anythingllm_mini.db

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/anythingllm_mini

# Vector store
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./storage/chroma

# Qdrant local example
QDRANT_PATH=./storage/qdrant

# File storage
UPLOAD_DIR=./storage/uploads
PARSED_DIR=./storage/parsed

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# Agent
AGENT_MAX_STEPS=5
